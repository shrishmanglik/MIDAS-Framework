{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://midas-framework.dev/schemas/quality-scorecard.schema.json",
  "type": "object",
  "required": ["schemaVersion", "policy", "components"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "midas.quality-scorecard.v1"
    },
    "policy": {
      "type": "object",
      "required": [
        "scoreScale",
        "minOverallScore",
        "minComponentScore",
        "minRequiredDimensionScore",
        "publicReleaseMinScore",
        "deterministicOnlyByDefault",
        "llmJudgesRequireExplicitApproval",
        "distributionClaimsRequireEvidence",
        "publicReleaseRequiresApproval",
        "generatedArtifactsAreNotSourceOfTruth",
        "externalComponentsRequireLicenseReview",
        "requiredDimensions",
        "allowedComponentKinds"
      ],
      "additionalProperties": false,
      "properties": {
        "scoreScale": { "const": "0-100" },
        "minOverallScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minComponentScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "minRequiredDimensionScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "publicReleaseMinScore": { "type": "integer", "minimum": 0, "maximum": 100 },
        "deterministicOnlyByDefault": { "type": "boolean" },
        "llmJudgesRequireExplicitApproval": { "type": "boolean" },
        "distributionClaimsRequireEvidence": { "type": "boolean" },
        "publicReleaseRequiresApproval": { "type": "boolean" },
        "generatedArtifactsAreNotSourceOfTruth": { "type": "boolean" },
        "externalComponentsRequireLicenseReview": { "type": "boolean" },
        "requiredDimensions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "allowedComponentKinds": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "artifactPath",
          "purpose",
          "distributionSurface",
          "dimensions",
          "risks",
          "releaseGate"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "artifactPath": { "type": "string" },
          "purpose": { "type": "string" },
          "distributionSurface": { "type": "string" },
          "dimensions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "score", "evidence"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "score": { "type": "integer", "minimum": 0, "maximum": 100 },
                "evidence": { "type": "string" }
              }
            }
          },
          "risks": {
            "type": "array",
            "items": { "type": "string" }
          },
          "releaseGate": {
            "type": "object",
            "required": ["claimLevel", "publicReleaseReady", "approvalRequired", "evidenceRequired"],
            "additionalProperties": false,
            "properties": {
              "claimLevel": {
                "enum": ["local-validation", "private-preview", "public-release"]
              },
              "publicReleaseReady": { "type": "boolean" },
              "approvalRequired": { "type": "boolean" },
              "evidenceRequired": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
