{#---
id: fastapi-model
tags: [fastapi, python, backend, model, sqlalchemy, database, orm]
category: fastapi
description: "SQLAlchemy model with UUID primary key, timestamps, and relationships"
vars:
  required: [entity, fields]
  optional: [relationships, table_args]
---#}
"""{{ entity | pascal_case }} SQLAlchemy model."""

import uuid
from datetime import datetime

from sqlalchemy import String, Integer, ForeignKey, Index, text
from sqlalchemy.dialects.postgresql import UUID
from sqlalchemy.orm import Mapped, mapped_column, relationship

from app.models.base import Base


class {{ entity | pascal_case }}(Base):
    __tablename__ = "{{ entity_plural | default(entity | snake_case + 's') | snake_case }}"

    id: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4
    )
    {% for field in fields %}
    {% if field.type == "string" %}
    {{ field.name }}: Mapped[str] = mapped_column(
        String({{ field.max_length | default(255) }}), nullable={{ field.nullable | default(false) }}
    )
    {% elif field.type == "integer" %}
    {{ field.name }}: Mapped[int] = mapped_column(
        Integer, nullable={{ field.nullable | default(false) }}
    )
    {% elif field.type == "fk" %}
    {{ field.name }}: Mapped[uuid.UUID] = mapped_column(
        UUID(as_uuid=True),
        ForeignKey("{{ field.references }}.id", ondelete="{{ field.on_delete | default('CASCADE') }}"),
        nullable={{ field.nullable | default(false) }},
    )
    {% endif %}
    {% endfor %}
    created_at: Mapped[datetime] = mapped_column(
        default=datetime.utcnow, server_default=text("NOW()")
    )
    updated_at: Mapped[datetime] = mapped_column(
        default=datetime.utcnow, onupdate=datetime.utcnow, server_default=text("NOW()")
    )
    {% if relationships is defined %}

    # Relationships
    {% for rel in relationships %}
    {{ rel.name }}: Mapped[{{ rel.mapped_type }}] = relationship(back_populates="{{ rel.back_populates }}")
    {% endfor %}
    {% endif %}
    {% if table_args is defined %}

    __table_args__ = (
        {% for arg in table_args %}
        {{ arg }},
        {% endfor %}
    )
    {% endif %}
