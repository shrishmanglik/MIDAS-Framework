{#---
id: fastapi-schema
tags: [fastapi, python, backend, schema, pydantic, validation]
category: fastapi
description: "Pydantic request/response schemas with field validation for a resource"
vars:
  required: [entity, fields]
  optional: [validators]
---#}
"""{{ entity | pascal_case }} Pydantic schemas for request/response validation."""

from datetime import datetime
from uuid import UUID

from pydantic import BaseModel, Field


class {{ entity | pascal_case }}Create(BaseModel):
    """Schema for creating a new {{ entity | snake_case }}."""
    {% for field in fields %}
    {% if not field.read_only | default(false) %}
    {{ field.name }}: {{ field.python_type }} = Field(
        ...,
        {% if field.min_length is defined %}min_length={{ field.min_length }},{% endif %}
        {% if field.max_length is defined %}max_length={{ field.max_length }},{% endif %}
        {% if field.ge is defined %}ge={{ field.ge }},{% endif %}
        {% if field.le is defined %}le={{ field.le }},{% endif %}
        {% if field.example is defined %}examples=[{{ field.example }}],{% endif %}
        description="{{ field.description | default('') }}",
    )
    {% endif %}
    {% endfor %}


class {{ entity | pascal_case }}Update(BaseModel):
    """Schema for updating an existing {{ entity | snake_case }}."""
    {% for field in fields %}
    {% if not field.read_only | default(false) %}
    {{ field.name }}: {{ field.python_type }} | None = Field(
        default=None,
        {% if field.min_length is defined %}min_length={{ field.min_length }},{% endif %}
        {% if field.max_length is defined %}max_length={{ field.max_length }},{% endif %}
        {% if field.ge is defined %}ge={{ field.ge }},{% endif %}
        {% if field.le is defined %}le={{ field.le }},{% endif %}
        description="{{ field.description | default('') }}",
    )
    {% endif %}
    {% endfor %}


class {{ entity | pascal_case }}Response(BaseModel):
    """Schema for {{ entity | snake_case }} response."""

    id: UUID
    {% for field in fields %}
    {{ field.name }}: {{ field.python_type }}
    {% endfor %}
    created_at: datetime
    updated_at: datetime

    model_config = {"from_attributes": True}


class {{ entity | pascal_case }}ListResponse(BaseModel):
    """Schema for paginated {{ entity | snake_case }} list response."""

    data: list[{{ entity | pascal_case }}Response]
    meta: dict
