{#---
id: fastapi-config
tags: [fastapi, python, backend, config, settings, environment]
category: fastapi
description: "Pydantic BaseSettings configuration loading from environment variables"
vars:
  required: [project_name]
  optional: [extra_settings]
---#}
"""Application configuration loaded from environment variables."""

from pydantic_settings import BaseSettings


class Settings(BaseSettings):
    """Application settings loaded from environment variables."""

    # Application
    app_name: str = "{{ project_name }}"
    debug: bool = False

    # Database
    database_url: str = "postgresql+asyncpg://postgres:postgres@localhost:5432/{{ project_name | snake_case }}"

    # Authentication
    jwt_secret: str = ""
    jwt_algorithm: str = "HS256"
    access_token_expire_minutes: int = 15
    refresh_token_expire_days: int = 7

    # CORS
    cors_origins: list[str] = ["http://localhost:3000"]

    # Server
    host: str = "0.0.0.0"
    port: int = 8000
    {% if extra_settings is defined %}

    # Project-specific settings
    {% for setting in extra_settings %}
    {{ setting.name }}: {{ setting.type }} = {{ setting.default }}
    {% endfor %}
    {% endif %}

    model_config = {"env_file": ".env", "env_file_encoding": "utf-8"}


settings = Settings()
