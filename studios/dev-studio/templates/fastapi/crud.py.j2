"""{{ entity | pascal_case }} service with CRUD operations."""

from uuid import UUID

from sqlalchemy import select, func
from sqlalchemy.ext.asyncio import AsyncSession

from app.models.{{ entity | snake_case }} import {{ entity | pascal_case }}
from app.schemas.{{ entity | snake_case }} import {{ entity | pascal_case }}Create, {{ entity | pascal_case }}Update


class {{ entity | pascal_case }}Service:
    """Business logic for {{ entity | snake_case }} operations."""

    def __init__(self, db: AsyncSession) -> None:
        self.db = db

    async def create(self, payload: {{ entity | pascal_case }}Create, owner_id: UUID) -> {{ entity | pascal_case }}:
        """Create a new {{ entity | snake_case }}."""
        item = {{ entity | pascal_case }}(
            **payload.model_dump(),
            {{ owner_field | default('owner_id') }}=owner_id,
        )
        self.db.add(item)
        await self.db.commit()
        await self.db.refresh(item)
        return item

    async def get(self, item_id: UUID) -> {{ entity | pascal_case }} | None:
        """Get a {{ entity | snake_case }} by ID."""
        query = select({{ entity | pascal_case }}).where({{ entity | pascal_case }}.id == item_id)
        result = await self.db.execute(query)
        return result.scalar_one_or_none()

    async def list(self, skip: int = 0, limit: int = 20) -> tuple[list[{{ entity | pascal_case }}], int]:
        """List {{ entity_plural | default(entity | snake_case + 's') | snake_case }} with pagination."""
        count_query = select(func.count()).select_from({{ entity | pascal_case }})
        total = (await self.db.execute(count_query)).scalar_one()
        query = (
            select({{ entity | pascal_case }})
            .offset(skip)
            .limit(limit)
            .order_by({{ entity | pascal_case }}.created_at.desc())
        )
        result = await self.db.execute(query)
        return list(result.scalars().all()), total

    async def update(
        self,
        item_id: UUID,
        payload: {{ entity | pascal_case }}Update,
        owner_id: UUID,
    ) -> {{ entity | pascal_case }} | None:
        """Update a {{ entity | snake_case }}. Verifies ownership."""
        item = await self.get(item_id)
        if not item or getattr(item, "{{ owner_field | default('owner_id') }}") != owner_id:
            return None
        update_data = payload.model_dump(exclude_unset=True)
        for key, value in update_data.items():
            setattr(item, key, value)
        await self.db.commit()
        await self.db.refresh(item)
        return item

    async def delete(self, item_id: UUID, owner_id: UUID) -> bool:
        """Delete a {{ entity | snake_case }}. Verifies ownership."""
        item = await self.get(item_id)
        if not item or getattr(item, "{{ owner_field | default('owner_id') }}") != owner_id:
            return False
        await self.db.delete(item)
        await self.db.commit()
        return True
