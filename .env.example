# Database connection (optional — defaults to in-memory for dev)
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/midas

# Anthropic API key (required for real LLM calls, not needed with mock provider)
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_JSON=true

# Budget defaults
DEFAULT_BUDGET=0.50

# Environment
MIDAS_ENV=development
